# Nuxt runtime config overrides.
# Copy to `.env` (gitignored) and adjust per environment.
# Only keys declared in nuxt.config.ts `runtimeConfig.public` are overridable.

# API base URL — products, categories and single-product endpoints.
# The host is deployment configuration, so it lives here rather than in the
# source: point it at the public API, a local mock, or an internal gateway.
# The app fails loudly at startup if this is missing, rather than silently
# calling the wrong host.
NUXT_PUBLIC_API_BASE=https://fakestoreapi.com

# Footer social profile URLs (fallbacks live in constants/site.ts).
NUXT_PUBLIC_SOCIAL_TELEGRAM=https://telegram.org
NUXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com
NUXT_PUBLIC_SOCIAL_TWITTER=https://twitter.com
NUXT_PUBLIC_SOCIAL_YOUTUBE=https://youtube.com
NUXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com
